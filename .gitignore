# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains keystore passwords, etc.)
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# OS generated files
.DS_Store
Thumbs.db

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint-results.html
lint-results.xml
